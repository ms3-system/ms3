# api-service local configuration
# Copy to .env and source it, or export these directly.
#
# Unlike the URL settings below, API_SERVICE_INTERNAL_TOKEN is REQUIRED —
# the service refuses to start without it (see internal/config/config.go).
# It must be the exact same value as auth-service's
# AUTH_SERVICE_INTERNAL_TOKEN (see auth-service/.env.example) — api-service
# sends it as X-Internal-Token when looking up credentials to verify SigV4
# signatures.

# Port the HTTP server listens on.
API_SERVICE_SERVER_PORT=8080

# Base URL of metadata-service.
API_SERVICE_METADATA_URL=http://localhost:8083

# Base URL of data-service.
API_SERVICE_DATA_URL=http://localhost:8081

# Base URL of auth-service, used for the internal credential lookup that
# backs SigV4 verification.
API_SERVICE_AUTH_URL=http://localhost:8082

# Shared secret sent as X-Internal-Token to auth-service. Must match
# auth-service's AUTH_SERVICE_INTERNAL_TOKEN exactly.
API_SERVICE_INTERNAL_TOKEN=local-dev-internal-token-change-me
