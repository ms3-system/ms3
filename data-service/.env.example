# data-service local configuration
# Copy to .env.example and source it, or export these directly. All are optional —
# the service runs with these defaults if nothing is set.

# Port the HTTP server listens on.
DATA_SERVICE_SERVER_PORT=8081

# Directory object bytes are stored under (created on demand, including
# the tmp/ subdirectory used for atomic writes).
DATA_SERVICE_DATA_DIR=data
