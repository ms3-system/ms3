# auth-service local configuration
# Copy to .env.example and source it, or export these directly.
#
# Unlike the other three services, AUTH_SERVICE_JWT_SECRET,
# AUTH_SERVICE_INTERNAL_TOKEN, and AUTH_SERVICE_MASTER_KEY are REQUIRED —
# the service refuses to start without them (see internal/config/config.go).
# The values below are throwaway local-dev values, safe to commit here
# because they are not used anywhere real.

# Port the HTTP server listens on.
AUTH_SERVICE_SERVER_PORT=8082

# Path to the bbolt database file. Created on demand, including parent dirs.
AUTH_SERVICE_DB_PATH=data/auth.db

# HMAC signing secret for access/refresh JWTs. Any non-empty string works
# for local dev.
AUTH_SERVICE_JWT_SECRET=local-dev-jwt-secret-change-me

# Shared secret api-service must send as X-Internal-Token to call
# /internal/credentials/{access_key}. Any non-empty string works for local
# dev (api-service does not call this endpoint yet — see
# docs/service-consistency-changes.md).
AUTH_SERVICE_INTERNAL_TOKEN=local-dev-internal-token-change-me

# Base64-encoded 32-byte AES-256 key used to encrypt credential secrets at
# rest. Generate your own with:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
AUTH_SERVICE_MASTER_KEY=4/NI5ZVXCJjvLHiTVfPB1NSPThY5ESxTBhXJiE1Y8mk=
